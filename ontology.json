    "total_unique": 42,
    "total_label_instances": 122,
    "total_benchmark_subsegments": 62,
    "labels": [
      {"surface": "Standing", "normalized": "standing", "level": "L1A", "count": 15},
      {"surface": "open_guard", "normalized": "open_guard", "level": "L1B", "count": 14},
      {"surface": "de_la_riva", "normalized": "de_la_riva_guard", "level": "L1B", "count": 10},
      {"surface": "Mount", "normalized": "mount", "level": "L1A", "count": 9},
      {"surface": "Side Control", "normalized": "side_control", "level": "L1A", "count": 6},
